{
  "name": "opendbgrid",
  "productName": "OpenDBGrid",
  "version": "0.1.0",
  "description": "A modern, cross-platform database GUI client & data grid (PostgreSQL first).",
  "main": "./out/main/index.js",
  "author": "OpenDBGrid",
  "homepage": "https://github.com/opendbgrid/opendbgrid",
  "desktopName": "opendbgrid",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:deb": "npm run build && electron-builder --linux deb --publish never",
    "build:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --dir tests",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:up": "bash scripts/dev-postgres.sh up",
    "db:down": "bash scripts/dev-postgres.sh down"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.0",
    "@lezer/highlight": "^1.2.0",
    "lucide-react": "^0.462.0",
    "pg": "^8.13.0",
    "react": "^19.2.0",
    "react-data-grid": "7.0.0-beta.61",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^2.1.0",
    "sql-formatter": "^15.8.0",
    "ssh2": "^1.16.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "41.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
